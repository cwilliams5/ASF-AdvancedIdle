<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<!-- CA1861 (hoist constant array args to static fields) trades test readability for a
		     perf concern tests don't have - expectation literals stay inline. Tests only. -->
		<NoWarn>$(NoWarn);CA1861</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="JetBrains.Annotations.Sources" PrivateAssets="all" />
		<!-- Version comes from ASF's central Directory.Packages.props (imported via ours). -->
		<PackageReference Include="MSTest" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\AdvancedIdle\AdvancedIdle.csproj" />
		<!-- The plugin references ASF with ExcludeAssets="all" because ASF-the-host provides those
		     assemblies at runtime. A test host is not ASF, so tests reference ASF directly to copy
		     the runtime closure (ASF.dll, AspNetCore.*) into the test output - the same pattern as
		     ASF's own ArchiSteamFarm.Tests. Without this, MSTest discovery dies on type load. -->
		<ProjectReference Include="..\ArchiSteamFarm\ArchiSteamFarm\ArchiSteamFarm.csproj" />
	</ItemGroup>
</Project>
