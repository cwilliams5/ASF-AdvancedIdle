<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>Library</OutputType>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="JetBrains.Annotations.Sources" PrivateAssets="all" />
		<PackageReference Include="Microsoft.AspNetCore.OpenApi" IncludeAssets="compile" />
		<PackageReference Include="SteamKit2" IncludeAssets="compile" />
		<PackageReference Include="System.Composition.AttributedModel" IncludeAssets="compile" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\ArchiSteamFarm\ArchiSteamFarm\ArchiSteamFarm.csproj" ExcludeAssets="all" Private="false" />
	</ItemGroup>

	<ItemGroup>
		<AssemblyMetadata Include="BuiltAgainstASF" Value="$(AsfBuiltAgainstVersion)" />
	</ItemGroup>

	<!-- Version handshake (SMOKE.md step 1): embed git describe into InformationalVersion AND
	     generate compile-time constants for the OnLoaded line, so a stale DLL in a plugins/
	     directory is identifiable from its log line alone. Constants, not runtime attribute
	     reflection: the trimmed win-x64 ASF host lacks the reflection-extension surface
	     (MissingMethodException in OnLoaded, live smoke 2026-07-09). -->
	<Target Name="EmbedGitDescribe" BeforeTargets="GenerateAssemblyInfo;GenerateHandshakeInfo">
		<Exec Command="git describe --always --dirty" ConsoleToMSBuild="true" ContinueOnError="true" StandardOutputImportance="low" IgnoreExitCode="true">
			<Output TaskParameter="ConsoleOutput" PropertyName="GitDescribe" />
		</Exec>
		<PropertyGroup>
			<GitDescribe Condition="'$(GitDescribe)' == ''">unknown</GitDescribe>
			<InformationalVersion>$(Version)+$(GitDescribe)</InformationalVersion>
		</PropertyGroup>
	</Target>

	<Target Name="GenerateHandshakeInfo" BeforeTargets="BeforeCompile;CoreCompile">
		<PropertyGroup>
			<HandshakeFile>$(IntermediateOutputPath)HandshakeInfo.g.cs</HandshakeFile>
		</PropertyGroup>
		<ItemGroup>
			<HandshakeLine Include="// Generated by GenerateHandshakeInfo (AdvancedIdle.csproj) - do not edit." />
			<HandshakeLine Include="namespace AdvancedIdle%3B" />
			<HandshakeLine Include="internal static class HandshakeInfo {" />
			<HandshakeLine Include="	public const string InformationalVersion = &quot;$(Version)+$(GitDescribe)&quot;%3B" />
			<HandshakeLine Include="	public const string BuiltAgainstAsf = &quot;$(AsfBuiltAgainstVersion)&quot;%3B" />
			<HandshakeLine Include="}" />
		</ItemGroup>
		<WriteLinesToFile File="$(HandshakeFile)" Lines="@(HandshakeLine)" Overwrite="true" WriteOnlyWhenDifferent="true" />
		<ItemGroup>
			<Compile Include="$(HandshakeFile)" />
		</ItemGroup>
	</Target>

	<Target Name="PostBuild" AfterTargets="PostBuildEvent">
		<Copy SourceFolders="$(TargetDir)" DestinationFolder="..\ArchiSteamFarm\ArchiSteamFarm\bin\$(Configuration)\$(TargetFramework)\plugins\$(AssemblyName)\" SkipUnchangedFiles="true" />
	</Target>
</Project>
